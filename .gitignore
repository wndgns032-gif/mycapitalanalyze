# API 키 등 민감정보 (절대 커밋 금지)
config.json
config.json.*
*.bak
*.key
.env
.env.*

# Google 서비스 계정 키 (로컬 보관용 — GitHub Secret 으로만 주입한다)
google-sa.json
.secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 번역 결과는 커밋한다 — CI에서 매번 재번역하면 비용이 든다.
# (content/translations/ 은 12개 언어 번역본. 용량 작음.)

# OS
.DS_Store
Thumbs.db

# 로컬 진단·스크린샷 (커밋하지 않는다)
_shared/
_shots/

# API 응답 캐시 (재생성 가능, 커밋 불필요)
.cache/

# 로컬 실행 로그 (임시 산출물)
_*.log

# ⚠️ affiliate_pool.json 은 **커밋해야 한다**.
#    GitHub Actions 러너에는 .secrets/ 가 없어 API 를 못 부른다.
#    풀을 안 커밋하면 자동 발행 시 카드가 0개가 된다 (2026-10-10).
